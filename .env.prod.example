# Base de datos
POSTGRES_DB=modoensayo
POSTGRES_USER=modoensayo
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# JWT — generar con: openssl rand -base64 32
JWT_SECRET=CAMBIAR_POR_SECRET_SEGURO

# MercadoPago — token de PRODUCCION (sin el prefijo TEST-)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# URLs públicas de la app
APP_FRONTEND_URL=https://tu-dominio.com
APP_BACKEND_URL=https://tu-dominio.com

# Almacenamiento (local o supabase)
STORAGE_PROVIDER=local
