# Supabase (frontend) — valores PÚBLICOS (no son secretos)
# Obtenibles en: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Legacy (solo durante la transición desde el backend Spring Boot).
# Vacío = mismo origen vía proxy de Vite.
VITE_API_BASE_URL=

# Google Analytics 4 (opcional). ID de medición de la propiedad GA4 (G-XXXXXXXXXX).
# Vacío = no se carga GA (sin tracking). Público (va en el HTML).
VITE_GA_MEASUREMENT_ID=
