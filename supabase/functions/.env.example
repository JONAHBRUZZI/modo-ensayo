# Secrets para Edge Functions (local: copiar a supabase/functions/.env)
# En Supabase Platform se setean con: supabase secrets set KEY=value
#
# Auto-inyectadas por Supabase (NO definir aquí en cloud/local CLI):
#   SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEYS, SUPABASE_JWKS
#   (las usa @supabase/server para auth + clientes RLS/admin)
#
# Custom de la app (sí setear):
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
APP_FRONTEND_URL=http://localhost:5173
FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
